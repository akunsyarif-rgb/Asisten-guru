# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (server-only). Never expose these to the client.
# AI_PROVIDER selects the adapter used by lib/ai/provider.ts:
# "openai" | "anthropic" | "gemini" | "mock"
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Gemini has a free tier (no billing required) via Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Data retention (days). See config/retention.ts
GENERATION_TEMP_RETENTION_DAYS=60
GENERATION_LOG_RETENTION_DAYS=120

# Rate limiting
GENERATION_RATE_LIMIT_PER_HOUR=30
